<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>ImageCompress.Dnx</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>dhhieu113</Authors>
    <Description>Cross-platform image compression CLI backed by Rust.</Description>
    <PackageTags>image;compress;rust;dnx;cli</PackageTags>
    <PackageProjectUrl>https://github.com/dhhieu113pro/image-compress-wasm</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dhhieu113pro/image-compress-wasm</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>image-compress</ToolCommandName>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <RollForward>Major</RollForward>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImageCompress.Dnx.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../artifacts/native/win-x64/image_compress.dll" Condition="Exists('../../artifacts/native/win-x64/image_compress.dll')" Pack="true" PackagePath="tools/net10.0/any/runtimes/win-x64/native/" Link="runtimes/win-x64/native/image_compress.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../artifacts/native/win-arm64/image_compress.dll" Condition="Exists('../../artifacts/native/win-arm64/image_compress.dll')" Pack="true" PackagePath="tools/net10.0/any/runtimes/win-arm64/native/" Link="runtimes/win-arm64/native/image_compress.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../artifacts/native/linux-x64/libimage_compress.so" Condition="Exists('../../artifacts/native/linux-x64/libimage_compress.so')" Pack="true" PackagePath="tools/net10.0/any/runtimes/linux-x64/native/" Link="runtimes/linux-x64/native/libimage_compress.so" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../artifacts/native/linux-arm64/libimage_compress.so" Condition="Exists('../../artifacts/native/linux-arm64/libimage_compress.so')" Pack="true" PackagePath="tools/net10.0/any/runtimes/linux-arm64/native/" Link="runtimes/linux-arm64/native/libimage_compress.so" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../artifacts/native/osx-x64/libimage_compress.dylib" Condition="Exists('../../artifacts/native/osx-x64/libimage_compress.dylib')" Pack="true" PackagePath="tools/net10.0/any/runtimes/osx-x64/native/" Link="runtimes/osx-x64/native/libimage_compress.dylib" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../artifacts/native/osx-arm64/libimage_compress.dylib" Condition="Exists('../../artifacts/native/osx-arm64/libimage_compress.dylib')" Pack="true" PackagePath="tools/net10.0/any/runtimes/osx-arm64/native/" Link="runtimes/osx-arm64/native/libimage_compress.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
